---
// Project posts: /es/project/{slug}/ and /en/project/{slug}/
import ProjectPostLayout from "~/layouts/ProjectPost.astro";
import { getCollection } from 'astro:content';
import { getProjectsByLanguage, formatDate } from "~/utils/content";

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const pages = await getCollection('pages');
  
  return projects.map((project) => {
    const language = project.data.language;
    const langProjects = getProjectsByLanguage(projects, language);
    const langIndex = langProjects.findIndex(p => p.data.permalink === project.data.permalink);
    const older = langIndex < langProjects.length - 1 ? langProjects[langIndex + 1] : null;
    const newer = langIndex > 0 ? langProjects[langIndex - 1] : null;
    
    const slugParts = project.data.permalink.replace(/^\/|\/$/g, '').split('/');
    const lang = slugParts[0];
    const rest = slugParts.slice(2); // skip 'project'
    
    return {
      params: { lang, slug: rest.join('/') },
      props: { project, older, newer, language, pages },
    };
  });
}

const { project, older, newer, language, pages } = Astro.props;
const { Content } = await project.render();

const langConfig = pages.find(p => p.data.type === 'language' && p.data.language === language);
const siteConfig = langConfig ? { slug: langConfig.data.permalink, title: langConfig.data.title } : null;
---

<ProjectPostLayout
  title={project.data.title}
  language={language}
  date={formatDate(project.data.date, language)}
  translations={project.data.translations}
  config={siteConfig}
  image={project.data.image}
>
  <div class="post-content">
    <Content />
  </div>
  
  <ul class="post-nav">
    <li>
      {older && (
        <a href={older.data.permalink} rel="prev">
          ← {older.data.title}
        </a>
      )}
    </li>
    <li>
      {newer && (
        <a href={newer.data.permalink} rel="next">
          {newer.data.title} →
        </a>
      )}
    </li>
  </ul>
</ProjectPostLayout>
