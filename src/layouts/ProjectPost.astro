---
import BaseLayout from '~/layouts/Layout.astro';

interface Props {
  title: string;
  language: string;
  description?: string;
  date?: string;
  translations?: string[];
  config?: { slug: string; title: string };
  image?: string;
}

const { title, language, description, date, translations, config, image } = Astro.props;
---

<BaseLayout
  title={`${title} | ${config?.title || 'Axai'}`}
  language={language}
  description={description}
  translations={translations}
  config={config}
>
  <article>
    <h1>{title}</h1>
    {date && <p class="meta">{date}</p>}
    {image && (
      <img src={image} alt={title} class="post-image" />
    )}
    <div class="post-content">
      <slot />
    </div>
  </article>
  <hr />
</BaseLayout>
