---
// Menu component - shows navigation links for the current language
import { getCollection } from 'astro:content';

interface Props {
  language: string;
}

const { language } = Astro.props;

const allPages = await getCollection('pages');
const menuPages = allPages
  .filter(p => {
    const lang = p.data.language;
    const type = p.data.type;
    return lang === language && (type === 'language' || type === 'blog-index');
  })
  .sort((a, b) => {
    // Sort: language (Inicio/Start) first, then blog-index
    if (a.data.type === 'language') return -1;
    if (b.data.type === 'language') return 1;
    return 0;
  });
---

<ul class="menu">
  {menuPages.map(page => (
    <li>
      <a href={page.data.permalink} title={page.data.title}>
        {page.data.menu_label}
      </a>
    </li>
  ))}
</ul>
